{
  "name": "spoticulum-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format:check": "prettier --check package.json vite.config.js playwright.config.js eslint.config.js src/platform src/setupTests.js src/App.test.js e2e"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-ga4": "3.0.1",
    "react-router-dom": "7.18.3",
    "semantic-ui-css": "2.5.0",
    "web-vitals": "6.2.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.19.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
