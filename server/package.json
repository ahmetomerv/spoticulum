{
  "name": "spoticulum-server",
  "version": "1.0.0",
  "private": true,
  "main": "app.js",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "build": "npm run build-client",
    "build-client": "npm --prefix ../client run build",
    "test": "node --test",
    "lint": "eslint .",
    "format:check": "prettier --check app.js src/createApp.js src/routes/authRoutes.js test package.json eslint.config.js"
  },
  "author": "Ahmet Ömer",
  "license": "MIT",
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "supertest": "7.2.2"
  }
}
