{
  "name": "spoticulum-server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/app.js",
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "start": "node dist/app.js",
    "dev": "tsx watch app.ts",
    "build": "npm run build:server && npm run build-client",
    "build:server": "npm run clean && npm run typecheck && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build-client": "npm --prefix ../client run build",
    "test": "tsx --test test/**/*.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check app.ts src test package.json tsconfig.json tsconfig.build.json eslint.config.js"
  },
  "author": "Ahmet Ömer",
  "license": "MIT",
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
